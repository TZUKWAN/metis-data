# Metis Data environment template — copy to .env and fill values.
# NEVER commit .env or real credentials. .env is git-ignored.

# --- Core ---
METIS_ENV=development
METIS_HOST=127.0.0.1
METIS_PORT=8300
# Absolute or relative path for runtime data (raw/intermediate/final/downloads/vault)
METIS_WORKSPACE_DIR=./metis/workspace
# SQLite database file
METIS_DB_URL=sqlite:///./metis/workspace/metis.db

# --- Logging ---
METIS_LOG_LEVEL=INFO
METIS_LOG_DIR=./metis/workspace/logs

# --- Browser (Playwright headed Chromium) ---
METIS_BROWSER_HEADLESS=false
METIS_BROWSER_CHANNEL=chromium
METIS_BROWSER_DOWNLOAD_DIR=./metis/workspace/downloads/browser
METIS_BROWSER_USER_DATA_DIR=./metis/workspace/browser-profile

# --- Vault ---
# Windows: DPAPI via Credential Manager (default). No plaintext fallback is implemented.
METIS_VAULT_BACKEND=wincred_dpapi
# Optional master unlock (if unset, OS-bound DPAPI scope is used)
METIS_VAULT_MASTER_KEY=

# --- Provider API keys (all optional; providers work anonymously where possible) ---
WORLD_BANK_API_BASE=https://api.worldbank.org/v2
EUROSTAT_API_BASE=https://ec.europa.eu/eurostat/api/dissemination
ILOSTAT_API_BASE=https://rplumber.ilo.org
DATAGOV_API_BASE=https://api.catalog.data.gov
DATAGOV_API_KEY=
ZENODO_API_BASE=https://zenodo.org/api
HARVARD_DATAVERSE_API_BASE=https://dataverse.harvard.edu/api
KAGGLE_API_BASE=https://www.kaggle.com/api/v1
# Kaggle credentials are optional (public search works anonymously); store in Vault, not here.
KAGGLE_USERNAME=
KAGGLE_KEY=
FRED_API_BASE=https://api.stlouisfed.org
FRED_API_KEY=
UNESCO_UIS_API_BASE=https://api-uis.unesco.org
# Default network behavior
METIS_HTTP_TIMEOUT_S=30
METIS_HTTP_MAX_RETRIES=2

# --- Search orchestration defaults ---
METIS_SEARCH_PROVIDER_TIMEOUT_S=45
METIS_SEARCH_MAX_CONCURRENCY=6
METIS_SEARCH_MAX_RETRIES=2

# --- Downloads ---
METIS_DOWNLOAD_MAX_BYTES=5368709120
METIS_DOWNLOAD_CHUNK=1048576

# --- Test fixtures (used by tests; never contains real secrets) ---
METIS_FIXTURE_SERVER=http://127.0.0.1:8310
